generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivateServiceKind {
  OUTING
  PRIVATE_VISIT
  CHAUFFEUR
}

enum TransferServiceType {
  AIRPORT_ROUTE
  PRIVATE_SERVICE
  CUSTOM_ROUTE
}

enum TransferRequestStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityReservationStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SurfPackageReservationStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SurfLessonReservationStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, isActive])
}

model TransferRoute {
  id        String            @id @default(cuid())
  from      String
  fromFr    String?
  to        String
  toFr      String?
  price     Float
  notes     String            @default("")
  notesFr   String            @default("")
  currency  String            @default("EUR")
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  requests  TransferRequest[]

  @@unique([from, to])
  @@index([isActive, sortOrder])
}

model PrivateTransferService {
  id             String             @id @default(cuid())
  name           String             @unique
  nameFr         String?
  kind           PrivateServiceKind @default(OUTING)
  description    String
  descriptionFr  String             @default("")
  price          Float
  currency       String             @default("EUR")
  passengerLimit Int                @default(8)
  duration       String             @default("À définir")
  durationFr     String             @default("")
  startTimes     String[]           @default([])
  image          String             @default("")
  imageAlt       String             @default("")
  imageAltFr     String             @default("")
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  requests       TransferRequest[]

  @@index([isActive, sortOrder])
}

model TransferLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  nameFr      String?
  isActive    Boolean  @default(true)
  isDeparture Boolean  @default(true)
  isArrival   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model TransferSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityCatalogItem {
  id        String   @id @default(cuid())
  slug      String   @unique
  data      Json
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ActivitySetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BlogCatalogItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  data        Json
  isPublished Boolean  @default(false)
  publishedAt DateTime @default(now())
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt, sortOrder])
}

model BlogSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CustomerReview {
  id        String   @id @default(cuid())
  name      String
  dateAdded DateTime @db.Date
  photoUrl  String   @default("")
  message   String
  messageFr String   @default("")
  rating    Int
  isPublished Boolean @default(true)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, dateAdded])
}

model GoogleReviewSetting {
  id             String   @id @default("homepage")
  location       String   @default("")
  googleUrl      String   @default("")
  HostelGrowthUrl  String   @default("")
  updatedAt      DateTime @updatedAt
}

model ConciergeSetting {
  id        String   @id @default("homepage")
  data      Json
  updatedAt DateTime @updatedAt
}

model HeroPresentationSetting {
  id        String   @id @default("homepage")
  data      Json
  updatedAt DateTime @updatedAt
}

model ExperienceGallerySetting {
  id        String   @id @default("homepage")
  data      Json
  updatedAt DateTime @updatedAt
}

model HomepageSectionsSetting {
  id        String   @id @default("homepage")
  data      Json
  updatedAt DateTime @updatedAt
}

model SurfPackageCatalogSetting {
  id        String   @id @default("catalog")
  data      Json
  updatedAt DateTime @updatedAt
}

model SurfPackageReservation {
  id               String                       @id @default(cuid())
  status           SurfPackageReservationStatus @default(NEW)
  packageId        String
  packageTitle     String
  customerName     String
  customerPhone    String
  customerEmail    String?
  notes            String?
  bookingDate      DateTime                     @db.Date
  bookingTime      String
  guests           Int
  pricePerPerson   Float
  estimatedTotal   Float
  currency         String                       @default("EUR")
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([status, createdAt])
  @@index([bookingDate, bookingTime])
}

model SurfLessonCatalogSetting {
  id        String   @id @default("catalog")
  data      Json
  updatedAt DateTime @updatedAt
}

model SurfLessonReservation {
  id               String                     @id @default(cuid())
  status           SurfLessonReservationStatus @default(NEW)
  lessonId         String
  lessonTitle      String
  customerName     String
  customerPhone    String
  customerEmail    String?
  notes            String?
  bookingDate      DateTime                   @db.Date
  bookingTime      String
  guests           Int
  pricePerPerson   Float
  estimatedTotal   Float
  currency         String                     @default("EUR")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([bookingDate, bookingTime])
}

model ActivityReservation {
  id                    String                     @id @default(cuid())
  status                ActivityReservationStatus  @default(NEW)
  customerName          String
  customerPhone         String
  customerEmail         String?
  hotelAddress          String?
  notes                 String?
  estimatedTotal        Float
  currency              String                     @default("EUR")
  priceNeedsConfirmation Boolean                   @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  lines                 ActivityReservationLine[]

  @@index([status, createdAt])
}

model ActivityReservationLine {
  id               String                       @id @default(cuid())
  reservationId    String
  reservation      ActivityReservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  activitySlug     String
  activityTitle    String
  activityLocation String
  activityImage    String                       @default("")
  rateLabel        String
  rateUnit         String
  rateBilling      String
  ratePrice        Float
  adults           Int
  children         Int                           @default(0)
  date             DateTime                      @db.Date
  time             String
  extras           Json
  lineTotal        Float
  slots            ConfirmedActivitySlot[]

  @@index([activitySlug, date, time])
}

model ConfirmedActivitySlot {
  id                String                 @id @default(cuid())
  activitySlug      String
  date              DateTime               @db.Date
  time              String
  reservationLineId String                 @unique
  reservationLine   ActivityReservationLine @relation(fields: [reservationLineId], references: [id], onDelete: Cascade)

  @@unique([activitySlug, date, time])
}

model TransferRequest {
  id               String                  @id @default(cuid())
  serviceType      TransferServiceType
  status           TransferRequestStatus   @default(NEW)
  serviceName      String
  routeId          String?
  route            TransferRoute?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  privateServiceId String?
  privateService   PrivateTransferService? @relation(fields: [privateServiceId], references: [id], onDelete: SetNull)
  departure        String
  arrival          String
  priceAtRequest   Float?
  currency         String                  @default("EUR")
  serviceDate      DateTime
  serviceTime      String?
  passengerCount   Int
  luggageCount     Int                     @default(0)
  hotelAddress     String?
  flightNumber     String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([serviceDate])
}
